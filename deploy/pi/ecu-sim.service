[Unit]
Description=Taktflow CDA ECU Simulator (upstream Kotlin)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f ecu-sim
ExecStart=/usr/bin/docker run --rm --name ecu-sim -p 13400:13400 taktflow/cda-ecu-sim:latest
ExecStop=/usr/bin/docker stop ecu-sim
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
